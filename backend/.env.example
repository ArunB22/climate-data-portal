# Copy to .env (or set as real environment variables / platform secrets on deploy).
# Never commit the filled-in .env file.

DB_URL=jdbc:postgresql://localhost:5432/climate_portal
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Generate your own for any real deployment, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Auto-seeded on first boot if no Super Admin exists yet
SUPER_ADMIN_EMAIL=superadmin@vasudhaindia.org
SUPER_ADMIN_PASSWORD=Admin@123
